            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Can we perceive two colors at the same time? A direct test of Huang and Pashlerâ€™s (2007) Boolean map theory of visual attention</rdf:li>
            </rdf:Alt>
